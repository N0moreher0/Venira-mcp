{
  "inputs": [
    {
      "type": "promptString",
      "id": "github-token",
      "description": "GitHub token (optional; required for PR and CI tools)",
      "password": true
    }
  ],
  "servers": {
    "venira": {
      "type": "stdio",
      "command": "node",
      "args": [
        "${workspaceFolder}\\dist\\server.js"
      ],
      "env": {
        "VENIRA_WORKSPACE": "${workspaceFolder}",
        "VENIRA_DATA_DIR": "${userHome}\\AppData\\Local\\venira",
        "VENIRA_UNRESTRICTED": "0",
        "VENIRA_DEFAULT_SHELL": "powershell",
        "VENIRA_SHELL_MODE": "balanced",
        "VENIRA_PERMISSION_MODE": "allow_all",
        "VENIRA_OUTPUT_MODE": "full",
        "VENIRA_GIT_TOKEN": "${input:github-token}"
      }
    }
  }
}
