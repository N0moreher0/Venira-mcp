{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "repositoryCaching": "enabled",
  "schedule": ["after 10am and before 4pm on weekdays"],
  "prCreation": "not-pending",
  "gitSubmodules": false,
  "packageRules": [
    {
      "matchManagers": ["npm"],
      "groupName": "npm",
      "schedule": ["after 10am and before 4pm on weekdays"]
    },
    {
      "matchPackageNames": ["better-sqlite3"],
      "enabled": true,
      "description": "Native module — bump minor/patch automatically, but major versions (new Node ABI / glibc changes) always stay manual so the prebuild + allowScripts + CI rebuild path is re-verified by a human first.",
      "major": {
        "enabled": true,
        "automerge": false,
        "stabilityDays": 3
      },
      "minor": {
        "automerge": true
      }
    },
    {
      "matchPackageNames": ["@modelcontextprotocol/sdk"],
      "enabled": true,
      "description": "MCP SDK — major bumps can change the wire protocol / server API; never auto-merge major.",
      "major": {
        "automerge": false,
        "stabilityDays": 7
      }
    }
  ],
  "vulnerabilityAlerts": {
    "enabled": true,
    "createTime": false
  },
  "ignoredPaths": ["package-lock.json"]
}
