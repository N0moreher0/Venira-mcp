# Create .gitattributes for line-ending normalization
*.md        text eol=lf
*.json      text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.ts        text eol=lf
*.js        text eol=lf
*.txt       text eol=lf
*.mdc       text eol=lf
*.sh        text eol=lf
*.ps1       text eol=crlf
*.cmd       text eol=crlf
*.bat       text eol=crlf
Dockerfile  text eol=lf
.gitignore  text eol=lf
.npmignore  text eol=lf
