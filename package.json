{
  "name": "venira-mcp",
  "version": "1.17.2",
  "description": "venira-mcp — a standalone Model Context Protocol (MCP) server that gives coding agents (OpenCode, Claude Desktop, any MCP client) workspace-scoped tools in default/expert modes: file read/write/edit/delete, batch reads, line-range reads, content search, recent files, code intelligence, dependency graph + change impact, async shell run/poll/cancel, git-free checkpoints/rollback, pull requests + GitLab/GitHub/Bitbucket CI integrations (including bounded CI waiting), encrypted secrets with rotation metadata, deterministic error diagnosis + read planning, and a SQLite WAL audit trail where mutations can record a reason. Pure Node, no external binary. Structured JSON envelopes with hints and cached validated reads. npm i venira-mcp, then point your MCP client at `venira` or `venira-mcp`.",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "coding-agent",
    "opencode",
    "claude-desktop",
    "mcp-server",
    "file-tools",
    "shell",
    "search",
    "audit",
    "audit-trail",
    "checkpoint",
    "snapshot",
    "rollback",
    "sqlite",
    "better-sqlite3",
    "typescript",
    "node",
    "ai-agent",
    "coding-assistant",
    "workspace",
    "batch-reads",
    "pull-request",
    "github-actions",
    "ci",
    "secrets",
    "secret-rotation",
    "diagnostics",
    "error-explanation",
    "read-planning",
    "venira",
    "venira-mcp"
  ],
  "homepage": "https://github.com/N0moreher0/Venira-mcp",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/N0moreher0/Venira-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/N0moreher0/Venira-mcp/issues"
  },
  "license": "AGPL-3.0-only",
  "type": "module",
  "main": "dist/server.js",
  "exports": {
    ".": "./dist/server.js",
    "./native": "./dist/lib/native-adapter-index.js",
    "./corehost": "./dist/lib/native-adapter-index.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "venira": "bin/venira-mcp.js",
    "venira-mcp": "bin/venira-mcp.js"
  },
  "files": [
    "dist/",
    "bin/",
    "README.md",
    "LICENSE",
    "SECURITY.md",
    "BENCHMARK-2026-11-07.md",
    "BENCHMARK-2026-11-07.json",
    "opencode.example.json",
    "CONTRIBUTING.md"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "tsx watch server.ts",
    "smoke": "tsx scripts/smoke.ts",
    "bench": "tsx scripts/bench.ts",
    "bench:mcp": "tsx scripts/bench-mcp.ts",
    "bench:tools": "npm run build && tsx scripts/bench-tools.ts",
    "verify": "npm run test:provider-secret-guard && npm run test:github-device-flow && npm run test:shell-security && npm run test:audit-verify && tsx scripts/verify.ts",
    "doctor": "tsx scripts/doctor.ts",
    "test:github-device-flow": "tsx scripts/test-github-device-flow.ts",
    "test:provider-secret-guard": "tsx scripts/test-provider-secret-guard.ts",
    "test:shell-security": "tsx scripts/test-shell-security-regressions.ts",
    "test:audit-verify": "tsx scripts/test-audit-verify.ts",
    "check:docs": "tsx scripts/check-docs.ts",
    "check:source-shape": "tsx scripts/check-source-shape.ts",
    "test:policy-corpus": "tsx scripts/policy-corpus-runner.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@secretlint/core": "^11.7.1",
    "@secretlint/secretlint-rule-gitlab": "^11.7.1",
    "@secretlint/secretlint-rule-preset-recommend": "^11.7.1",
    "better-sqlite3": "12.4.1",
    "jsonc-parser": "^3.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.0",
    "@types/node": "^22.0.0",
    "prettier": "^3.9.10",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  },
  "allowScripts": {
    "better-sqlite3@12.4.1": true,
    "esbuild@0.28.2": true,
    "keytar@7.9.0": true
  },
  "optionalDependencies": {
    "keytar": "^7.9.0"
  }
}
