{
  "name": "venira-mcp",
  "version": "1.0.5",
  "description": "venira-mcp — a standalone Model Context Protocol (MCP) server that gives coding agents (OpenCode, Claude Desktop, any MCP client) 16 workspace-scoped tools: file read/write/edit/delete, batch reads, line-range reads, content search, recent files, async shell run/poll/cancel, and a full SQLite WAL audit trail. Pure Node, no external binary. Structured JSON envelopes with hints and cached validated reads. npm i venira-mcp, then point your MCP client at `venira` or `venira-mcp`.",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "coding-agent",
    "opencode",
    "claude-desktop",
    "mcp-server",
    "file-tools",
    "shell",
    "search",
    "audit",
    "sqlite",
    "better-sqlite3",
    "typescript",
    "node",
    "ai-agent",
    "coding-assistant",
    "workspace",
    "batch-reads",
    "venira",
    "venira-mcp"
  ],
  "homepage": "https://github.com/N0moreher0/Venira-mcp",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/N0moreher0/Venira-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/N0moreher0/Venira-mcp/issues"
  },
  "license": "MIT OR Apache-2.0",
  "type": "module",
  "main": "dist/server.js",
  "bin": {
    "venira": "bin/venira-mcp.js",
    "venira-mcp": "bin/venira-mcp.js"
  },
  "files": [
    "dist/",
    "bin/",
    "README.md",
    "LICENSE",
    "LICENSE-APACHE2.0.txt",
    "opencode.example.json",
    "CONTRIBUTING.md"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "tsx watch server.ts",
    "smoke": "tsx scripts/smoke.ts",
    "bench": "tsx scripts/bench.ts",
    "bench:mcp": "tsx scripts/bench-mcp.ts",
    "verify": "tsx scripts/verify.ts",
    "doctor": "tsx scripts/doctor.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "better-sqlite3": "^11.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.0",
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  },
  "allowScripts": {
    "better-sqlite3@11.10.0": true,
    "esbuild@0.28.2": true
  }
}
